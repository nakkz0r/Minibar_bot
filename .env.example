# =========================================================
#  Шаблон настроек. Скопируйте в файл .env и заполните.
#  ВАЖНО: сюда (в .env.example) реальные значения НЕ вписывать —
#  этот файл попадает в git и виден всем!
# =========================================================

# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_from_botfather

# ID рабочего чата, куда бот шлёт отчёты (у групп ID отрицательный).
# Подсказка: добавьте бота в группу и отправьте там /myid
REPORT_CHAT_ID=-1001234567890

# Юзернеймы ответственных — просто текст, который дописывается в отчёт
SUPERVISORS=@supervisor1, @supervisor2

# Telegram User ID администраторов (через запятую) — /clear и настройка каталога.
# Узнать свой ID: команда /myid у бота
ADMIN_IDS=123456789

# Telegram User ID супервайзеров (через запятую) — /audit, /product, /export и т.д.
SUPERVISORS_IDS=123456789,987654321

# --- Автоматизация смены (время Тбилиси, формат ЧЧ:ММ; пусто = выключено) ---
# Во сколько бот сам отправит Excel-отчёт смены в рабочий чат
AUTO_REPORT_TIME=
# Во сколько бот сам закроет смену: архив в облако + очистка базы
AUTO_CLEAR_TIME=

# Порт HTTP-сервера (Render подставляет PORT автоматически)
PORT=8080

# Cloudflare R2 (S3-совместимое хранилище) для бэкапов базы и фото
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=minibar-bot-storage
